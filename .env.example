# --- Exness Partnership API (leave blank to run on sample data) ---
EXN_API_KEY=exnsk_...
EXN_PRIVATE_KEY_PATH=./keys/exness_ed25519.pem
# EXN_PRIVATE_KEY=            # or the key itself: PEM text or the 128-char hex from Exness Key Management (use for Codespaces secrets)
EXN_HOST=https://api.exness.com
# MOCK=1                      # force sample data even when keys are set

# --- Claude brief + nudge rewrites ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Telegram ---
TG_BOT_TOKEN=
TG_CHAT_ID=                   # partner's chat for the morning brief
TG_CLIENT_CHAT_ID=            # opted-in channel where approved lessons go

# --- Branding / landing ---
BRAND=Trade Hour
PARTNER_LINK=https://one.toexness.com/a/ijfv29rud7
EXD_REWARD_AMOUNT=10                  # sign-up reward in EXD
EXD_TERMS="Sent in EXD once your Exness account is opened through Trade Hour, verified and funded. One sign-up reward per person."
MILESTONES=1:2,10:5,50:10,100:20,250:40   # lots:EXD
# USE_SNAPSHOT=0              # ignore data/snapshot.json (real data captured via the Exness connector)
# DEMO_FUNNEL=0               # don't show sample campaigns when you have no tracked links

# --- Server ---
HOST=127.0.0.1
PORT=8787
DASH_TOKEN=                   # set before exposing the server beyond localhost
CACHE_TTL=600
